# automatically generated - proxy netdata backend servers
upstream netdata_backend {
{% for host in groups['backend'] %}
  server {{ hostvars[host]['ansible_host'] | default(hostvars[host]['inventory_hostname']) }}:19999;
{% endfor %}
}

server {
    listen 80;
    server_name _;

    location / {
        proxy_pass http://netdata_backend/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
